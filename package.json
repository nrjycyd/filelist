{
  "name": "vitepress-plugin-filelist",
  "version": "0.10.3",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "type": "module",
  "description": "OpenList file browser for VitePress: browse, preview, search and batch-download OpenList files in a docs page, with folder passwords, paging and light / dark themes.",
  "author": "nrjycyd",
  "license": "MIT",
  "homepage": "https://nrjycyd.github.io/filelist/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nrjycyd/filelist.git"
  },
  "bugs": {
    "url": "https://github.com/nrjycyd/filelist/issues"
  },
  "keywords": [
    "vitepress",
    "vitepress-plugin",
    "openlist",
    "alist",
    "filelist",
    "netdisk"
  ],
  "exports": {
    ".": "./dist/node/index.js",
    "./client": {
      "browser": "./dist/client/browser/index.js",
      "default": "./dist/client/ssr/index.js"
    },
    "./style.css": "./dist/client/style.css",
    "./package.json": "./package.json"
  },
  "module": "./dist/node/index.js",
  "types": "./dist/node/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown && node scripts/fix-dts.mjs && pnpm --filter ./packages/* run build",
    "typecheck": "vue-tsc --noEmit && pnpm --filter ./packages/* run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack:check": "npm pack --dry-run",
    "test:e2e": "playwright test",
    "e2e:site": "pnpm run build && pnpm --dir demo install --force && pnpm --dir demo run build:e2e",
    "test:compat": "node scripts/compat.mjs",
    "test:compat:vuepress": "pnpm --filter vuepress-plugin-filelist run test:compat"
  },
  "peerDependencies": {
    "vitepress": "^1.6.0 || >=2.0.0-alpha.18",
    "vitepress-tuck": ">=0.12.2",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "vitepress": {
      "optional": true
    },
    "vitepress-tuck": {
      "optional": true
    }
  },
  "dependencies": {
    "client-zip": "^2.5.1",
    "dompurify": "^3.4.17",
    "markdown-it": "^14.3.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.63.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.10.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "happy-dom": "^21.0.4",
    "tsdown": "^0.23.7",
    "typescript": "^5.6.0",
    "unplugin-vue": "^8.0.1",
    "unrun": "^0.3.1",
    "vitepress": "^2.0.0-alpha.21",
    "vitepress-tuck": "^0.12.2",
    "vitest": "^5.1.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.2.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
